        <mxCell id="note2" parent="1" style="shape=note;whiteSpace=wrap;html=1;fillColor=#FFFDE7;strokeColor=#BDB76B;fontSize=10;" value="Tipos PostgreSQL: BigAutoField → bigint; DateTimeField → timestamp with time zone (timestamptz); ImageField almacena la ruta del archivo como varchar. Las FK usan ON DELETE PROTECT según los models.py." vertex="1">
