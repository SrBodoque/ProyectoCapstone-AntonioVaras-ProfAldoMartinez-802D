        <mxCell id="m1" edge="1" parent="1" source="a_u_1" style="endArrow=block;endFill=1;html=1;rounded=0;strokeWidth=1.3;fontSize=11;" target="a_va_1" value="1. El usuario ingresa al baño / cruza la zona de acceso">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="m2" edge="1" parent="1" source="a_va_2" style="endArrow=block;endFill=1;html=1;rounded=0;strokeWidth=1.3;fontSize=11;loopDirection=0;" target="a_va_2" value="2. Detectar, trackear y confirmar evento IN">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="m3" edge="1" parent="1" source="a_va_3" style="endArrow=block;endFill=1;html=1;rounded=0;strokeWidth=1.3;fontSize=11;" target="a_out_3" value="3. Guardar evento confirmado en outbox">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="m4" edge="1" parent="1" source="a_send_4" style="endArrow=block;endFill=1;html=1;rounded=0;strokeWidth=1.3;fontSize=11;" target="a_out_4" value="4. Leer evento pendiente">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="m5" edge="1" parent="1" source="a_out_5" style="endArrow=open;endFill=0;html=1;rounded=0;dashed=1;strokeColor=#666666;fontSize=10;" target="a_send_5" value="5. Retornar evento pendiente">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="m6" edge="1" parent="1" source="a_send_6" style="endArrow=block;endFill=1;html=1;rounded=0;strokeWidth=1.3;fontSize=11;" target="a_back_6" value="6. Enviar POST con token Bearer y payload JSON">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="m7" edge="1" parent="1" source="a_back_7" style="endArrow=block;endFill=1;html=1;rounded=0;strokeWidth=1.3;fontSize=11;loopDirection=0;" target="a_back_7" value="7. Validar token, payload e idempotencia">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="m8" edge="1" parent="1" source="a_back_8" style="endArrow=block;endFill=1;html=1;rounded=0;strokeWidth=1.3;fontSize=11;" target="a_db_8" value="8. Registrar EventoConteo (ENTRADA)">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="m9" edge="1" parent="1" source="a_back_9" style="endArrow=block;endFill=1;html=1;rounded=0;strokeWidth=1.3;fontSize=11;" target="a_db_9" value="9. Consultar entradas del ciclo y alertas activas">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="m10" edge="1" parent="1" source="a_back_10" style="endArrow=block;endFill=1;html=1;rounded=0;strokeWidth=1.3;fontSize=11;" target="a_db_10" value="10. Crear Alerta (PENDIENTE) [si se alcanza el umbral]">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="m11" edge="1" parent="1" source="a_back_11" style="endArrow=open;endFill=0;html=1;rounded=0;dashed=1;strokeColor=#666666;fontSize=10;" target="a_send_11" value="11. Responder 201/200 OK">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="m12" edge="1" parent="1" source="a_send_12" style="endArrow=block;endFill=1;html=1;rounded=0;strokeWidth=1.3;fontSize=11;" target="a_out_12" value="12. Marcar evento como enviado">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="m13" edge="1" parent="1" source="a_t_13" style="endArrow=block;endFill=1;html=1;rounded=0;strokeWidth=1.3;fontSize=11;" target="a_web_13" value="13. Iniciar sesión / abrir panel de trabajo">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="m14" edge="1" parent="1" source="a_web_14" style="endArrow=block;endFill=1;html=1;rounded=0;strokeWidth=1.3;fontSize=11;" target="a_db_14" value="14. Consultar asignación y alerta pendiente">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="m15" edge="1" parent="1" source="a_db_15" style="endArrow=open;endFill=0;html=1;rounded=0;dashed=1;strokeColor=#666666;fontSize=10;" target="a_web_15" value="15. Retornar asignación + alerta">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="m16" edge="1" parent="1" source="a_web_16" style="endArrow=block;endFill=1;html=1;rounded=0;strokeWidth=1.3;fontSize=11;" target="a_t_16" value="16. Mostrar alerta pendiente">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="m17" edge="1" parent="1" source="a_t_17" style="endArrow=block;endFill=1;html=1;rounded=0;strokeWidth=1.3;fontSize=11;" target="a_web_17" value="17. Iniciar limpieza">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="m18" edge="1" parent="1" source="a_web_18" style="endArrow=block;endFill=1;html=1;rounded=0;strokeWidth=1.3;fontSize=11;" target="a_db_18" value="18. Crear Intervención y cambiar alerta a EN_PROCESO">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="m19" edge="1" parent="1" source="a_db_19" style="endArrow=open;endFill=0;html=1;rounded=0;dashed=1;strokeColor=#666666;fontSize=10;" target="a_web_19" value="19. Confirmar limpieza en curso">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="m20" edge="1" parent="1" source="a_t_20" style="endArrow=block;endFill=1;html=1;rounded=0;strokeWidth=1.3;fontSize=11;" target="a_web_20" value="20. Finalizar limpieza + adjuntar evidencia">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="m21" edge="1" parent="1" source="a_web_21" style="endArrow=block;endFill=1;html=1;rounded=0;strokeWidth=1.3;fontSize=11;" target="a_db_21" value="21. Guardar evidencia / fecha_fin y cambiar alerta a ATENDIDA">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="m22" edge="1" parent="1" source="a_db_22" style="endArrow=open;endFill=0;html=1;rounded=0;dashed=1;strokeColor=#666666;fontSize=10;" target="a_web_22" value="22. Confirmar registro">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="m23" edge="1" parent="1" source="a_web_23" style="endArrow=block;endFill=1;html=1;rounded=0;strokeWidth=1.3;fontSize=11;" target="a_t_23" value="23. Mostrar confirmación e historial actualizado">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="note1" parent="1" style="shape=note;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;" value="Regla de negocio: solo se crea una alerta si el baño alcanza el umbral de entradas y no existe otra alerta pendiente o en proceso." vertex="1">
          <mxGeometry height="72" width="500" x="1040" y="560" as="geometry" />
        </mxCell>
        <mxCell id="note2" parent="1" style="shape=note;whiteSpace=wrap;html=1;fillColor=#FCE5CD;strokeColor=#E69138;fontSize=11;" value="El trabajador debe tener una asignación activa al baño correspondiente para poder iniciar la limpieza." vertex="1">
          <mxGeometry height="70" width="320" x="1760" y="848" as="geometry" />
        </mxCell>
        <mxCell id="note3" parent="1" style="shape=note;whiteSpace=wrap;html=1;fillColor=#D9EAD3;strokeColor=#6AA84F;fontSize=11;" value="Al finalizar, se guarda evidencia fotográfica y la alerta queda en estado ATENDIDA." vertex="1">
          <mxGeometry height="60" width="420" x="1000" y="979" as="geometry" />
        </mxCell>
        <mxCell id="legend" parent="1" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontColor=#555555;" value="Diagrama basado en el flujo real implementado por visión artificial, outbox, envío HTTP, API Django, alertas e intervenciones." vertex="1">
          <mxGeometry height="34" width="1650" x="250" y="1080" as="geometry" />
        </mxCell>
      </root>
